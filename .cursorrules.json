{
  "projectInfo": {
    "name": "Open Interpreter HTTP Server",
    "description": "HTTP API service for Open Interpreter with OpenAI compatibility",
    "framework": "Flask",
    "language": "Python",
    "version": "0.1.0"
  },
  "rules": [
    {
      "pattern": "^def \\w+\\([^\\)]*\\):",
      "message": "Function definitions must include type annotations and docstrings",
      "severity": "error",
      "context": "development"
    },
    {
      "pattern": "print\\(",
      "message": "Use logging module instead of print statements",
      "severity": "warning",
      "context": "production"
    },
    {
      "pattern": "os\\.environ\\[",
      "message": "Use python-dotenv to manage environment variables",
      "severity": "warning",
      "context": "development"
    }
  ],
  "conventions": {
    "naming": {
      "functions": "snake_case",
      "classes": "PascalCase",
      "constants": "UPPER_CASE",
      "variables": "snake_case"
    },
    "style": {
      "maxLineLength": 88,
      "quoteStyle": "double",
      "indentation": "spaces",
      "spacesPerIndent": 4
    },
    "patterns": {
      "endpoints": "/v1/{resource}",
      "errorHandling": "try/except with specific exceptions",
      "logging": "structured logging with levels"
    }
  },
  "dependencies": {
    "core": [
      "flask==3.1.0",
      "python-dotenv==1.0.1",
      "requests==2.32.3"
    ],
    "testing": [
      "pytest",
      "pytest-cov",
      "pytest-flask"
    ],
    "development": [
      "black",
      "flake8",
      "mypy"
    ]
  },
  "ignorePatterns": [
    "**/__pycache__/**",
    "**/.pytest_cache/**",
    "**/venv/**",
    "**/.env",
    "**/TODO.md",
    "**/progress.md"
  ],
  "ruleFiles": {
    "codingStandards": ".cursor/rules/coding-standards.yaml",
    "documentation": ".cursor/rules/documentation.yaml",
    "projectSpecific": ".cursor/rules/project-specific.yaml"
  },
  "aiInstructions": {
    "preferredLanguage": "English",
    "codeLanguage": "English",
    "development": {
      "phaseOrder": true,
      "requireTests": true,
      "requireDocs": true
    },
    "communication": {
      "format": "markdown",
      "includeTimestamps": true,
      "updateProgress": true
    }
  }
}